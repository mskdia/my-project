<!DOCTYPE html>
<html lang="ko" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="문동규 (dong gue) - 공공기관 40년 경력의 청렴·감사 전문가, AI 입문 교육강사, 작가 & 개발자" />
  <title>문동규 (dong gue) | 청렴·AI 교육 전문가 &amp; 작가</title>

  <!-- 깔끔한 한국어 가독성을 위한 시스템 및 웹폰트 스타일링 (외부 라이브러리 없음) -->
  <style>
    /* ==========================================================================
       1. 디자인 토큰 & CSS 변수 (라이트 / 다크 모드 지원)
       ========================================================================== */
    :root {
      /* 라이트 모드 팔레트: 차분하고 신뢰감 있는 오프화이트 + 딥 네이비 + 웜 골드 */
      --bg-primary: #f8f9fb;
      --bg-secondary: #ffffff;
      --bg-tertiary: #eef1f6;
      --text-primary: #162238;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --accent-navy: #1e3a5f;
      --accent-navy-hover: #142842;
      --accent-gold: #b47b2b;
      --accent-gold-soft: rgba(180, 123, 43, 0.12);
      --border-color: #e2e8f0;
      --shadow-sm: 0 2px 8px rgba(22, 34, 56, 0.05);
      --shadow-md: 0 10px 25px rgba(22, 34, 56, 0.08);
      --shadow-lg: 0 20px 40px rgba(22, 34, 56, 0.12);
      --header-bg: rgba(248, 249, 251, 0.88);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --transition: all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    [data-theme="dark"] {
      /* 다크 모드 팔레트: 눈이 편안한 딥 슬레이트 + 부드러운 앰버 골드 */
      --bg-primary: #0f172a;
      --bg-secondary: #1e293b;
      --bg-tertiary: #283548;
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent-navy: #60a5fa;
      --accent-navy-hover: #93c5fd;
      --accent-gold: #eab308;
      --accent-gold-soft: rgba(234, 179, 8, 0.14);
      --border-color: #334155;
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 10px 25px rgba(0, 0, 0, 0.35);
      --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.45);
      --header-bg: rgba(15, 23, 42, 0.88);
    }

    /* ==========================================================================
       2. 기본 리셋 및 타이포그래피
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.7;
      word-break: keep-all;
      transition: background-color 0.3s ease, color 0.3s ease;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }

    ul {
      list-style: none;
    }

    .container {
      width: 100%;
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==========================================================================
       3. 상단 내비게이션 바 (Header)
       ========================================================================== */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background-color: var(--header-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 70px;
    }

    .brand {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--text-primary);
    }

    .brand-handle {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--accent-gold);
      letter-spacing: 0.02em;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-link {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--text-secondary);
      position: relative;
      padding: 6px 2px;
      transition: color 0.2s ease;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      background-color: var(--accent-gold);
      transition: width 0.25s ease;
    }

    .nav-link:hover,
    .nav-link.active {
      color: var(--text-primary);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
      width: 100%;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .theme-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background-color: var(--bg-tertiary);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .theme-toggle:hover {
      border-color: var(--accent-gold);
      transform: translateY(-1px);
    }

    .mobile-menu-btn {
      display: none;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      background-color: var(--bg-tertiary);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
    }

    /* ==========================================================================
       4. 히어로 섹션 (Hero / 소개)
       ========================================================================== */
    .hero {
      padding: 88px 0 76px;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 48px;
      align-items: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background-color: var(--accent-gold-soft);
      color: var(--accent-gold);
      font-size: 0.86rem;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .hero-title {
      font-size: clamp(2.1rem, 4vw, 2.9rem);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
      color: var(--text-primary);
    }

    .hero-title span {
      font-weight: 500;
      font-size: 0.58em;
      color: var(--text-muted);
      margin-left: 8px;
    }

    .hero-subtitle {
      font-size: 1.12rem;
      font-weight: 600;
      color: var(--accent-navy);
      margin-bottom: 22px;
      line-height: 1.5;
    }

    .hero-desc {
      font-size: 1.02rem;
      color: var(--text-secondary);
      margin-bottom: 32px;
      max-width: 620px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 24px;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      font-weight: 600;
      transition: var(--transition);
    }

    .btn-primary {
      background-color: var(--accent-navy);
      color: #ffffff;
      box-shadow: var(--shadow-sm);
    }

    [data-theme="dark"] .btn-primary {
      color: #0f172a;
    }

    .btn-primary:hover {
      background-color: var(--accent-navy-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .btn-outline {
      background-color: var(--bg-secondary);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
    }

    .btn-outline:hover {
      border-color: var(--accent-gold);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    /* 프로필 요약 카드 (우측) */
    .profile-card {
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 32px 28px;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }

    .profile-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--accent-navy), var(--accent-gold));
    }

    .profile-monogram {
      width: 68px;
      height: 68px;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--accent-navy), #2c5282);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 18px;
      letter-spacing: 0.04em;
    }

    [data-theme="dark"] .profile-monogram {
      color: #0f172a;
      background: linear-gradient(135deg, #60a5fa, #eab308);
    }

    .profile-card h3 {
      font-size: 1.2rem;
      margin-bottom: 6px;
    }

    .profile-location {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 20px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--border-color);
    }

    .profile-highlights {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .profile-highlights li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.92rem;
      color: var(--text-secondary);
    }

    .highlight-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: var(--accent-gold);
      margin-top: 8px;
      flex-shrink: 0;
    }

    /* ==========================================================================
       5. 공통 섹션 헤더 스타일
       ========================================================================== */
    .section {
      padding: 80px 0;
      border-top: 1px solid var(--border-color);
    }

    .section-header {
      margin-bottom: 40px;
    }

    .section-eyebrow {
      display: inline-block;
      font-size: 0.84rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-gold);
      margin-bottom: 8px;
    }

    .section-title {
      font-size: clamp(1.65rem, 3vw, 2.1rem);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    .section-subtitle {
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 640px;
    }

    /* ==========================================================================
       6. 주요 활동 및 전문 분야 (인터랙티브 필터 탭 + 카드 그리드)
       ========================================================================== */
    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 32px;
    }

    .filter-btn {
      padding: 9px 18px;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      background-color: var(--bg-secondary);
      color: var(--text-secondary);
      border: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .filter-btn:hover {
      border-color: var(--accent-navy);
      color: var(--text-primary);
    }

    .filter-btn.active {
      background-color: var(--accent-navy);
      color: #ffffff;
      border-color: var(--accent-navy);
    }

    [data-theme="dark"] .filter-btn.active {
      color: #0f172a;
    }

    .expertise-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .expertise-card {
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 30px;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .expertise-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--accent-gold);
    }

    .expertise-card.hidden {
      display: none;
    }

    .card-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background-color: var(--accent-gold-soft);
      color: var(--accent-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .card-category {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--accent-gold);
      margin-bottom: 6px;
    }

    .card-title {
      font-size: 1.24rem;
      font-weight: 700;
      margin-bottom: 14px;
      color: var(--text-primary);
    }

    .card-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .card-list li {
      position: relative;
      padding-left: 16px;
    }

    .card-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--accent-navy);
      font-weight: bold;
    }

    /* ==========================================================================
       7. 주요 저서 및 프로젝트 (Books & Projects)
       ========================================================================== */
    .works-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .works-column-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--text-primary);
    }

    .work-stack {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .work-card {
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 26px;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    .work-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .status-badge {
      display: inline-block;
      padding: 4px 11px;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .badge-published {
      background-color: rgba(22, 163, 74, 0.12);
      color: #15803d;
    }

    [data-theme="dark"] .badge-published {
      background-color: rgba(74, 222, 128, 0.15);
      color: #4ade80;
    }

    .badge-writing {
      background-color: var(--accent-gold-soft);
      color: var(--accent-gold);
    }

    .badge-dev {
      background-color: rgba(30, 58, 95, 0.1);
      color: var(--accent-navy);
    }

    [data-theme="dark"] .badge-dev {
      background-color: rgba(96, 165, 250, 0.15);
      color: #60a5fa;
    }

    .work-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--text-primary);
    }

    .work-desc {
      font-size: 0.94rem;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .work-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 6px;
      background-color: var(--bg-tertiary);
      color: var(--text-secondary);
      font-weight: 500;
    }

    .work-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 14px;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--accent-navy);
    }

    .work-link:hover {
      text-decoration: underline;
    }

    /* ==========================================================================
       8. 연락처 및 링크 (Contact)
       ========================================================================== */
    .contact-box {
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 42px;
      box-shadow: var(--shadow-md);
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 36px;
      align-items: center;
    }

    .contact-info h3 {
      font-size: 1.45rem;
      margin-bottom: 12px;
    }

    .contact-info p {
      color: var(--text-secondary);
      margin-bottom: 24px;
      font-size: 0.98rem;
    }

    .contact-methods {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      background-color: var(--bg-primary);
      border: 1px solid var(--border-color);
    }

    .contact-item-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .contact-icon {
      color: var(--accent-gold);
      flex-shrink: 0;
      display: flex;
    }

    .contact-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: block;
    }

    .contact-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-primary);
      word-break: break-all;
    }

    .copy-btn {
      padding: 7px 13px;
      border-radius: 6px;
      background-color: var(--accent-navy);
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 600;
      flex-shrink: 0;
      transition: var(--transition);
    }

    [data-theme="dark"] .copy-btn {
      color: #0f172a;
    }

    .copy-btn:hover {
      background-color: var(--accent-navy-hover);
    }

    /* ==========================================================================
       9. 푸터 & 토스트 알림
       ========================================================================== */
    .footer {
      padding: 36px 0;
      border-top: 1px solid var(--border-color);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    .toast {
      position: fixed;
      bottom: 28px;
      right: 28px;
      background-color: var(--text-primary);
      color: var(--bg-primary);
      padding: 13px 22px;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 600;
      box-shadow: var(--shadow-lg);
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: opacity 0.3s ease, transform 0.3s ease;
      z-index: 999;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       10. 스크롤 등장 애니메이션 (Scroll Reveal)
       ========================================================================== */
    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       11. 반응형 미디어 쿼리 (태블릿 & 모바일 최적화)
       ========================================================================== */
    @media (max-width: 900px) {
      .hero-grid,
      .works-layout,
      .contact-box {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 56px 0 60px;
      }
    }

    @media (max-width: 720px) {
      .expertise-grid {
        grid-template-columns: 1fr;
      }

      .mobile-menu-btn {
        display: inline-flex;
      }

      .nav-menu {
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background-color: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
        flex-direction: column;
        align-items: flex-start;
        padding: 16px 24px 22px;
        gap: 14px;
        display: none;
        box-shadow: var(--shadow-md);
      }

      .nav-menu.open {
        display: flex;
      }

      .contact-box {
        padding: 28px 20px;
      }

      .contact-item {
        flex-direction: column;
        align-items: flex-start;
      }

      .copy-btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
</head>
<body>

  <!-- 상단 내비게이션 -->
  <header class="navbar">
    <div class="container nav-container">
      <a href="#intro" class="brand">
        문동규 <span class="brand-handle">@dong gue</span>
      </a>

      <nav class="nav-menu" id="navMenu" aria-label="주요 메뉴">
        <a href="#intro" class="nav-link active">소개</a>
        <a href="#expertise" class="nav-link">주요 활동</a>
        <a href="#works" class="nav-link">저서 및 프로젝트</a>
        <a href="#contact" class="nav-link">문의</a>
      </nav>

      <div class="nav-actions">
